<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | {{ site.nome }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Karla:wght@400;500;700&display=swap">
<link rel="stylesheet" href="/css/style.css">
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"HairSalon",
  "name":"{{ site.nome }}",
  "telephone":"{{ site.telefono }}",
  "email":"{{ site.email }}",
  "address":{"@type":"PostalAddress","streetAddress":"{{ site.indirizzo }}",
    "postalCode":"{{ site.cap }}","addressLocality":"{{ site.citta }}","addressCountry":"FI"},
  "openingHours":["Mo-Fr 09:00-18:00","Sa 09:00-15:00"]
}
</script>
</head>
<body>
{% include "header.njk" %}
<div class="wrap" id="top">
{{ content | safe }}
{% include "footer.njk" %}
</div>
<script src="/css/lang.js"></script>
</body>
</html>
