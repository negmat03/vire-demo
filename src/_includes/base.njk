<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | {{ site.nome }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.dominio }}{{ page.url | url }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23{{ site.colori.accento | replace('#','') }}'/><text x='16' y='23' font-family='Georgia,serif' font-size='20' fill='white' text-anchor='middle'>{{ site.insegna[0] }}</text></svg>">
<meta property="og:type" content="business.business">
<meta property="og:title" content="{{ title }} | {{ site.nome }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.dominio }}{{ page.url | url }}">
<meta property="og:locale" content="fi_FI">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Karla:wght@400;500;700&display=swap">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"HairSalon",
  "name":"{{ site.nome }}",
  "telephone":"{{ site.telefono }}",
  "email":"{{ site.email }}",
  "address":{"@type":"PostalAddress","streetAddress":"{{ site.indirizzo }}",
    "postalCode":"{{ site.cap }}","addressLocality":"{{ site.citta }}","addressCountry":"FI"},
  "openingHours":["Mo-Fr 09:00-18:00","Sa 09:00-15:00"]
}
</script>
</head>
<body>
{% include "header.njk" %}
<div class="wrap" id="top">
{{ content | safe }}
{% include "footer.njk" %}
</div>
<script src="{{ '/css/lang.js' | url }}"></script>
</body>
</html>
